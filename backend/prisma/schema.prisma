  toNumber          String
  status            String?
  outcome           CallLogOutcome?
  aiSummary         String?
  transcript        String?
  recordingUrl      String?
  successEvaluation Float?
  durationSec       Int?
  startedAt         DateTime        @default(now())
  endedAt           DateTime?
  rawJson           Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model IdempotencyKey {
  key       String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model SystemFlag {
  id               String   @id @default("singleton")
  disableMessaging Boolean  @default(false)
  disableOutreach  Boolean  @default(false)
  disableWebhooks  Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model BulkImportJob {
  id            String           @id @default(cuid())
  orgId         String
  organization  Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type          String // e.g. "PROSPECT", "OUTREACH_LEAD"
  status        BulkImportStatus @default(QUEUED)
  totalRows     Int              @default(0)
  processedRows Int              @default(0)
  failedRows    Int              @default(0)
  error         String?
  sourceData    String? // Durable source of truth for the raw CSV data
  successCount  Int              @default(0)
  failureCount  Int              @default(0)
  lastError     String?          
  failedAt      DateTime?
  attempts      Int              @default(0)
  metadataJson  Json?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([orgId, status])
  @@index([createdAt])
}

model AgentDefinition {
  id             String        @id @default(cuid())
  key            String        @unique
  name           String
  description    String
  domain         AiAgentDomain
  enabled        Boolean       @default(true)
  allowedToolsJson Json        @default("[]")
  allowedEntitiesJson Json     @default("[]")
  approvalPolicy ApprovalPolicy @default(ALWAYS)
  modelProvider  String        @default("openai")
  modelName      String?
  promptKey      String
  visibilityRulesJson Json     @default("{}")
  priority       Int           @default(100)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workspaceSettings WorkspaceAgentSetting[]
  runs           AgentRun[]
  actionLogs     AgentActionLog[]
}

model WorkspaceAiSetting {
  id                               String       @id @default(cuid())
  orgId                            String       @unique
  organization                     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  enabled                          Boolean      @default(false)
  allowClientStaffApprovals        Boolean      @default(false)
  defaultApprovalPolicy            ApprovalPolicy @default(ALWAYS)
  allowlistRolesJson               Json         @default("[]")
  copilotEnabled                   Boolean      @default(false)
  managerInsightsEnabled           Boolean      @default(false)
  updatedByUserId                  String?
  createdAt                        DateTime     @default(now())
  updatedAt                        DateTime     @updatedAt
}

model WorkspaceAgentSetting {
  id                   String         @id @default(cuid())
  orgId                String
  organization         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentDefinitionId    String
  agentDefinition      AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)
  enabled              Boolean        @default(true)
  allowedToolsJson     Json           @default("[]")
  approvalPolicyOverride ApprovalPolicy?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([orgId, agentDefinitionId])
  @@index([orgId, enabled])
}

model AgentRun {
  id                   String         @id @default(cuid())
  orgId                String
  organization         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentDefinitionId    String
  agentDefinition      AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Restrict)
  initiatedByUserId    String?
  initiatedByUser      User?          @relation("AgentRunInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  status               AiRunStatus    @default(QUEUED)
  routeReason          String
  inputSummary         String?
  outputSummary        String?
  confidence           Float?
  errorCode            String?
  errorSummary         String?
  entityType           String?
  entityId             String?
  idempotencyKey       String?        @unique
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  actionLogs           AgentActionLog[]
  approvalRequests     ApprovalRequest[]

  @@index([orgId, createdAt])
  @@index([orgId, status, createdAt])
  @@index([orgId, entityType, entityId, createdAt])
}

model AgentActionLog {
  id                  String         @id @default(cuid())
  orgId               String
  organization        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentRunId          String
  agentRun            AgentRun       @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  agentDefinitionId   String
  agentDefinition     AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Restrict)
  actionType          String
  toolKey             String?
  status              AiActionStatus @default(PENDING)
  inputSummary        String?
  outputSummary       String?
  confidence          Float?
  approvalRequired    Boolean        @default(false)
  approvalStatus      ApprovalStatus?
  approvalRequestId   String?
  entityType          String?
  entityId            String?
  errorCode           String?
  errorSummary        String?
  metadataJson        Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([orgId, createdAt])
  @@index([orgId, status, createdAt])
  @@index([approvalRequestId])
}

model ApprovalRequest {
  id                  String         @id @default(cuid())
  orgId               String
  organization        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agentRunId          String?
  agentRun            AgentRun?      @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  requestedByUserId   String?
  requestedByUser     User?          @relation("ApprovalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  actionType          String
  toolKey             String
  entityType          String?
  entityId            String?
  status              ApprovalStatus @default(PENDING)
  reason              String?
  inputSummary        String?
  outputSummary       String?
  expiresAt           DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  actions             ApprovalAction[]

  @@index([orgId, status, createdAt])
  @@index([orgId, entityType, entityId, createdAt])
}

model ApprovalAction {
  id                  String         @id @default(cuid())
  orgId               String
  organization        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  approvalRequestId   String

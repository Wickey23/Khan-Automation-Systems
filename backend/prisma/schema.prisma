generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum ClientStatus {
  NEEDS_CONFIGURATION
  LIVE
  PAUSED
  CANCELED
}

enum UserRole {
  CLIENT
  ADMIN
  SUPER_ADMIN
  CLIENT_ADMIN
  CLIENT_STAFF
}

enum OrganizationStatus {
  NEW
  ONBOARDING
  SUBMITTED
  NEEDS_CHANGES
  APPROVED
  PROVISIONING
  TESTING
  LIVE
  PAUSED
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  NEEDS_CHANGES
  APPROVED
}

enum NumberProvider {
  TWILIO
  VAPI
}

enum PhoneNumberStatus {
  RESERVED
  ACTIVE
  RELEASED
}

enum AiProvider {
  VAPI
  OPENAI
  OTHER
}

enum AgentConfigStatus {
  DRAFT
  ACTIVE
}

enum CallLogOutcome {
  APPOINTMENT_REQUEST
  MESSAGE_TAKEN
  TRANSFERRED
  MISSED
  ABANDONED
  SPAM
}

enum TestRunStatus {
  PASS
  FAIL
}

enum LeadSource {
  WEB_FORM
  PHONE_CALL
  SMS
}

enum ProspectStatus {
  NEW
  QUALIFIED
  CONTACTED
  NURTURE
  WON
  LOST
}

enum ProspectSource {
  MANUAL
  CSV_IMPORT
  ENRICHED
}

enum SubscriptionPlan {
  STARTER
  PRO
}

enum LeadPipelineStage {
  NEW_LEAD
  QUOTED
  NEEDS_SCHEDULING
  SCHEDULED
  COMPLETED
}

enum LeadClassification {
  BOOKED_JOB
  QUOTE_REQUEST
  EMERGENCY
  CUSTOMER_SUPPORT
  SPAM
  MISSED_CALL_RECOVERY
  GENERAL_INQUIRY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum AppointmentRequestStatus {
  PENDING_REVIEW
  APPROVED
  DENIED
  SLOT_OFFERED
  SCHEDULED
  CLOSED
}

enum AppointmentRequestSource {
  WORKER
  BACKFILLED
  MANUAL
}

enum AppointmentRequestEventType {
  CREATED
  BACKFILLED
  APPROVED
  DENIED
  ASSIGNED
  SLOTS_OFFERED
  SLOT_SELECTED
  APPOINTMENT_CREATED
  CLOSED
  FOLLOW_UP_PHONE_UPDATED
  MANUAL_OVERRIDE
  REPAIRED
}

enum AppointmentRequestActorType {
  SYSTEM
  USER
  WORKER
  BACKFILL
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
  INTERNAL
}

enum AppointmentHoldStatus {
  HELD
  CONFIRMED
  FAILED
  EXPIRED
}

enum NotificationSeverity {
  INFO
  ACTION_REQUIRED
  URGENT
}

enum NotificationType {
  NEW_LEAD_CAPTURED
  APPOINTMENT_BOOKED
  MISSED_CALL_RECOVERY_NEEDED
  EMERGENCY_CALL_FLAGGED
  SECURITY_WEBHOOK_RETRY_FAILURE
  SECURITY_SMS_AUTOMATION_SUPPRESSED
}

enum ClassificationMethod {
  RULES
  LLM_FALLBACK
}

enum TeamMembershipRole {
  ADMIN
  MANAGER
  VIEWER
}

enum TeamMembershipStatus {
  ACTIVE
  INVITED
}

enum CallOutcome {
  AI_HANDLED
  TRANSFERRED
  MISSED
  UNKNOWN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  FAILED
  DELIVERED
}

enum OutreachLeadStatus {
  NEW
  ACTIVE
  PAUSED
  REPLIED
  BOUNCED
  UNSUBSCRIBED
  COMPLETED
}

enum OutreachEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
  FAILED
}

enum OutreachPhoneEventType {
  QUEUED
  STARTED
  COMPLETED
  FAILED
}

enum OutreachEmailEventType {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
  REPLIED
  UNSUBSCRIBED
  COMPLETED
}

enum AppointmentSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum BulkImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum CallState {
  RINGING
  CONNECTED
  AI_ACTIVE
  TRANSFERRED
  COMPLETED
}

enum OrgOverrideMode {
  DEFAULT
  FORCE_ON
  FORCE_OFF
}

enum ScaleGateResult {
  PASS
  FAIL
}

enum AiAgentDomain {
  FRONT_DESK
  LEAD_OPS
  COMMUNICATIONS
  SCHEDULING
  CRM_PIPELINE
  TASK_FOLLOW_UP
  KNOWLEDGE
  MANAGER_ANALYTICS
  DISPATCH_OPS
}

enum AiRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  BLOCKED_APPROVAL
}

enum AiActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ApprovalPolicy {
  ALWAYS
  ROLE_BASED
  RISK_BASED
  NONE
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskSource {
  MANUAL
  AI_AGENT
  CALL
  MESSAGE
  LEAD
  APPOINTMENT
}

model Client {
  id            String         @id @default(cuid())
  name          String
  industry      String?
  status        ClientStatus   @default(NEEDS_CONFIGURATION)
  users         User[]
  subscriptions Subscription[]
  setting       Setting?
  aiConfig      AIConfig?
  calls         Call[]
  leads         Lead[]
  phoneLine     PhoneLine?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Organization {
  id                       String                      @id @default(cuid())
  name                     String
  industry                 String?
  status                   OrganizationStatus          @default(NEW)
  live                     Boolean                     @default(false)
  stripeCustomerId         String?                     @unique
  subscriptionStatus       String                      @default("inactive")
  billingActive            Boolean                     @default(false)
  includedSeats            Int                         @default(1)
  purchasedSeats           Int                         @default(0)
  routingEngineOverride    OrgOverrideMode             @default(DEFAULT)
  autoRecoveryOverride     OrgOverrideMode             @default(DEFAULT)
  smsSendOverride          OrgOverrideMode             @default(DEFAULT)
  slaMonitorOverride       OrgOverrideMode             @default(DEFAULT)
  onboardingApprovedAt     DateTime?
  goLiveAt                 DateTime?
  firstSuccessAt           DateTime?
  firstSuccessType         String?
  users                    User[]
  subscriptions            Subscription[]
  onboardingSubmissions    OnboardingSubmission[]
  phoneNumbers             PhoneNumber[]
  aiAgentConfigs           AiAgentConfig[]
  callLogs                 CallLog[]
  callMediaStreamSessions  CallMediaStreamSession[]
  callTranscriptSessions   CallTranscriptSession[]
  callTranscriptSegments   CallTranscriptSegment[]
  leads                    Lead[]
  prospects                Prospect[]
  provisioningChecklist    ProvisioningChecklist?
  auditLogs                AuditLog[]
  businessSettings         BusinessSettings?
  configPackage            ConfigPackage?
  aiConfigVersions         AiAgentConfigVersion[]
  configPackageVersions    ConfigPackageVersion[]
  testScenarios            TestScenario[]
  testRuns                 TestRun[]
  webhookEventLogs         WebhookEventLog[]
  billingWebhookEvents     BillingWebhookEvent[]
  demoState                OrganizationDemoState?
  demoAiAttempts           DemoAiAttempt[]
  demoUpgradeSmsThrottle   DemoUpgradeSmsThrottle[]
  messageThreads           MessageThread[]
  messages                 Message[]
  appointmentRequests      AppointmentRequest[]
  appointmentRequestEvents AppointmentRequestEvent[]
  knowledgeFiles           OrganizationKnowledgeFile[]
  callerProfiles           CallerProfile[]
  autoRecoveryDedupes      AutoRecoveryDedupe[]
  scaleGateDecisions       ScaleGateDecisionLog[]
  memberships              OrganizationMembership[]
  appointments             Appointment[]
  appointmentHolds         AppointmentHold[]
  calendarConnections      CalendarConnection[]
  orgNotifications         OrgNotification[]
  callClassificationLogs   CallClassificationLog[]
  serviceRequests          ServiceRequest[]
  outreachLeads            OutreachLead[]
  outreachSequences        OutreachSequence[]
  outreachCallerConfigs    OutreachCallerConfig[]
  outreachEnrollments      OutreachEnrollment[]
  outreachPhoneEnrollments OutreachPhoneEnrollment[]
  outreachEmailEvents      OutreachEmailEvent[]
  outreachPhoneEvents      OutreachPhoneEvent[]
  outreachSuppressions     OutreachSuppression[]
  bulkImportJobs           BulkImportJob[]
  smsWebhookEvents         SmsWebhookEvent[]
  workspaceAiSettings      WorkspaceAiSetting?
  workspaceAgentSettings   WorkspaceAgentSetting[]
  workspaceKnowledge       WorkspaceKnowledgeEntry[]
  agentRuns                AgentRun[]
  agentActionLogs          AgentActionLog[]
  approvalRequests         ApprovalRequest[]
  approvalActions          ApprovalAction[]
  entityNotes              EntityNote[]
  threadClassifications    ThreadClassification[]
  callAiSummaries          CallAiSummary[]
  messageAiSummaries       MessageAiSummary[]
  tasks                    Task[]
  taskReminders            TaskReminder[]
  followUpQueueItems       FollowUpQueueItem[]
  pipelineRecords          PipelineRecord[]
  pipelineActivityLogs     PipelineActivityLog[]

  // Outbound Safety Quotas
  maxMessagesPerDay Int      @default(100)
  messagesSentToday Int      @default(0)
  maxCallsPerDay    Int      @default(50)
  callsHandledToday Int      @default(0)
  quotaResetAt      DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prospect {
  id           String         @id @default(cuid())
  orgId        String?
  organization Organization?  @relation(fields: [orgId], references: [id], onDelete: SetNull)
  name         String
  business     String
  email        String?
  phone        String?
  website      String?
  industry     String?
  city         String?
  state        String?
  status       ProspectStatus @default(NEW)
  source       ProspectSource @default(MANUAL)
  score        Int?
  scoreReason  String?
  tags         String         @default("")
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model User {
  id                          String                   @id @default(cuid())
  email                       String                   @unique
  passwordHash                String
  role                        UserRole                 @default(CLIENT)
  clientId                    String?
  client                      Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  orgId                       String?
  organization                Organization?            @relation(fields: [orgId], references: [id], onDelete: SetNull)
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  loginChallenges             LoginChallenge[]
  refreshSessions             RefreshSession[]
  passwordResetTokens         PasswordResetToken[]
  memberships                 OrganizationMembership[]
  assignedAppointmentRequests AppointmentRequest[]     @relation("AppointmentRequestAssignedUser")
  reviewedAppointmentRequests AppointmentRequest[]     @relation("AppointmentRequestReviewedByUser")
  initiatedAgentRuns         AgentRun[]                @relation("AgentRunInitiatedBy")
  approvalRequests           ApprovalRequest[]         @relation("ApprovalRequestedBy")
  approvalActions            ApprovalAction[]
  assignedTasks              Task[]                    @relation("TaskAssignee")
  createdTasks               Task[]                    @relation("TaskCreatedBy")
}

model OrganizationMembership {
  id              String               @id @default(cuid())
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  role            TeamMembershipRole
  status          TeamMembershipStatus
  invitedEmail    String
  invitedBy       String?
  invitedAt       DateTime?
  acceptedAt      DateTime?
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([invitedEmail, status])
  @@index([inviteTokenHash])
}

model Subscription {
  id                     String            @id @default(cuid())
  clientId               String?
  client                 Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orgId                  String?
  organization           Organization?     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan
  stripeCustomerId       String            @unique
  stripeSubscriptionId   String            @unique
  status                 String
  currentPeriodEnd       DateTime?
  pendingPlan            SubscriptionPlan?
  pendingPlanEffectiveAt DateTime?
  pendingPlanSource      String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model OnboardingSubmission {
  id                String           @id @default(cuid())
  orgId             String           @unique
  organization      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  status            OnboardingStatus @default(DRAFT)
  answersJson       String           @default("{}")
  configPackageJson String           @default("{}")
  submittedAt       DateTime?
  reviewedAt        DateTime?
  notesFromAdmin    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model OrganizationKnowledgeFile {
  id               String       @id @default(cuid())
  orgId            String
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fileName         String
  mimeType         String
  sizeBytes        Int
  contentText      String
  uploadedByUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orgId, createdAt])
}

model PhoneNumber {
  id             String            @id @default(cuid())
  orgId          String
  organization   Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider       NumberProvider    @default(TWILIO)
  twilioPhoneSid String?
  e164Number     String            @unique
  friendlyName   String?
  status         PhoneNumberStatus @default(RESERVED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model AiAgentConfig {
  id                String                 @id @default(cuid())
  orgId             String                 @unique
  organization      Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider          AiProvider             @default(VAPI)
  vapiAgentId       String?
  vapiPhoneNumberId String?
  agentId           String?
  apiKeyRef         String?
  voice             String?
  model             String?
  temperature       Float?
  systemPrompt      String?
  toolsJson         String?
  intakeSchemaJson  String?
  toolsEnabledJson  String?
  transferRulesJson String?
  status            AgentConfigStatus      @default(DRAFT)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  versions          AiAgentConfigVersion[]
}

model CallLog {
  id                        String                   @id @default(cuid())
  orgId                     String
  organization              Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  providerCallId            String?
  parentCallSid             String?
  accountSid                String?
  fromNumber                String
  toNumber                  String
  forwardedToNumber         String?
  direction                 String                   @default("inbound")
  aiProvider                AiProvider?
  aiSummary                 String?
  appointmentRequested      Boolean                  @default(false)
  leadId                    String?
  lead                      Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  initialWebhookAt          DateTime?
  startedAt                 DateTime                 @default(now())
  answeredAt                DateTime?
  endedAt                   DateTime?
  durationSec               Int?
  recordingUrl              String?
  transcript                String?
  outcome                   CallLogOutcome           @default(MESSAGE_TAKEN)
  transferReason            String?
  transferTarget            String?
  durationBeforeTransferSec Int?
  unansweredTransfer        Boolean                  @default(false)
  recoverySmsSentAt         DateTime?
  recoverySmsResponse       String?
  recoverySmsThreadId       String?
  callStatus                String?
  dialCallStatus            String?
  answeredBy                String?
  missedReason              String?
  rawJson                   Json?
  rawStatusPayload          Json?
  source                    String                   @default("twilio")
  hasMediaStream            Boolean                  @default(false)
  latestStreamStatus        String?
  voiceRoutingMode          String?
  aiFallbackInvoked         Boolean                  @default(false)
  aiFallbackInvokedAt       DateTime?
  humanAttemptDialStatus    String?
  transcriptStatus          String?
  transcriptGeneratedAt     DateTime?
  aiSummaryGeneratedAt      DateTime?
  state                     CallState?
  ringingAt                 DateTime?
  connectedAt               DateTime?
  aiStartedAt               DateTime?
  transferredAt             DateTime?
  completedAt               DateTime?
  routingDecisionJson       Json?
  callQualityScore          Int?
  callQualityBreakdownJson  Json?
  callQualityVersion        String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  stateTransitions          CallStateTransition[]
  sourceLeads               Lead[]                   @relation("LeadSourceCall")
  appointments              Appointment[]
  appointmentRequest        AppointmentRequest?
  classificationLogs        CallClassificationLog[]
  mediaStreamSessions       CallMediaStreamSession[]
  transcriptSessions        CallTranscriptSession[]
  transcriptSegments        CallTranscriptSegment[]
  serviceRequest            ServiceRequest?
  aiSummaries               CallAiSummary[]

  @@unique([orgId, providerCallId])
  @@index([orgId])
  @@index([providerCallId])
  @@index([fromNumber])
  @@index([createdAt])
}

model CallMediaStreamSession {
  id                   String                  @id @default(cuid())
  callLogId            String
  callLog              CallLog                 @relation(fields: [callLogId], references: [id], onDelete: Cascade)
  orgId                String
  organization         Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider             String                  @default("twilio")
  streamSid            String?                 @unique
  callSid              String
  parentCallSid        String?
  streamName           String?
  trackStrategy        String
  streamStatus         String
  websocketConnectedAt DateTime?
  mediaStartedAt       DateTime?
  mediaEndedAt         DateTime?
  lastMediaAt          DateTime?
  stopReason           String?
  streamMetadata       Json?
  customParametersJson Json?
  startPayloadJson     Json?
  stopPayloadJson      Json?
  lastSequenceNumber   Int?
  mediaEventCount      Int                     @default(0)
  inboundChunkCount    Int                     @default(0)
  outboundChunkCount   Int                     @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  transcriptSessions   CallTranscriptSession[]

  @@index([callLogId])
  @@index([orgId, createdAt])
  @@index([streamSid])
  @@index([callSid])
  @@index([streamStatus, createdAt])
}

model CallTranscriptSession {
  id                   String                  @id @default(cuid())
  callLogId            String
  callLog              CallLog                 @relation(fields: [callLogId], references: [id], onDelete: Cascade)
  streamSessionId      String
  streamSession        CallMediaStreamSession  @relation(fields: [streamSessionId], references: [id], onDelete: Cascade)
  orgId                String
  organization         Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider             String
  sessionStatus        String
  startedAt            DateTime
  endedAt              DateTime?
  providerMetadataJson Json?
  errorText            String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  segments             CallTranscriptSegment[]

  @@index([callLogId])
  @@index([streamSessionId])
  @@index([orgId, createdAt])
}

model CallTranscriptSegment {
  id                  String                @id @default(cuid())
  transcriptSessionId String
  transcriptSession   CallTranscriptSession @relation(fields: [transcriptSessionId], references: [id], onDelete: Cascade)
  callLogId           String
  callLog             CallLog               @relation(fields: [callLogId], references: [id], onDelete: Cascade)
  orgId               String
  organization        Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  streamSid           String?
  speaker             String
  text                String
  confidence          Float?
  startTimeMs         Int
  endTimeMs           Int
  sequence            Int
  isFinal             Boolean
  providerSegmentId   String?
  createdAt           DateTime              @default(now())

  @@unique([transcriptSessionId, sequence])
  @@index([transcriptSessionId, sequence])
  @@index([callLogId, sequence])
  @@index([orgId, createdAt])
}

model CallerProfile {
  id           String          @id @default(cuid())
  orgId        String
  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  phoneNumber  String
  totalCalls   Int             @default(0)
  firstCallAt  DateTime
  lastCallAt   DateTime
  lastOutcome  CallLogOutcome?
  flaggedVIP   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([orgId, phoneNumber])
  @@index([orgId, lastCallAt])
}

model CallStateTransition {
  id           String     @id @default(cuid())
  callLogId    String
  callLog      CallLog    @relation(fields: [callLogId], references: [id], onDelete: Cascade)
  fromState    CallState?
  toState      CallState
  at           DateTime   @default(now())
  metadataJson Json       @default("{}")
  createdAt    DateTime   @default(now())

  @@index([callLogId, at])
}

model AutoRecoveryDedupe {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  phoneNumber  String
  reasonCode   String
  windowBucket String
  createdAt    DateTime     @default(now())

  @@unique([orgId, phoneNumber, reasonCode, windowBucket])
  @@index([orgId, createdAt])
}

model Setting {
  id                String   @id @default(cuid())
  clientId          String   @unique
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessHoursJson String   @default("{\"timezone\":\"America/New_York\",\"schedule\":{}}")
  transferNumber    String   @default("")
  servicesJson      String?
  bookingLink       String?
  paused            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AIConfig {
  id                  String   @id @default(cuid())
  clientId            String   @unique
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  greetingText        String?
  systemPrompt        String?
  intakeQuestionsJson String?
  transferRulesJson   String?
  afterHoursMessage   String?
  smsEnabled          Boolean  @default(false)
  testMode            Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model Call {
  id           String      @id @default(cuid())
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromNumber   String
  toNumber     String
  startedAt    DateTime    @default(now())
  endedAt      DateTime?
  outcome      CallOutcome @default(UNKNOWN)
  recordingUrl String?
  transcript   String?
  summary      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model PhoneLine {
  id                     String   @id @default(cuid())
  clientId               String   @unique
  client                 Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  provider               String   @default("TWILIO")
  phoneNumber            String?
  twilioIncomingPhoneSid String?
  voiceWebhookUrl        String?
  smsWebhookUrl          String?
  capabilitiesJson       String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Lead {
  id                       String               @id @default(cuid())
  clientId                 String?
  client                   Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  orgId                    String?
  organization             Organization?        @relation(fields: [orgId], references: [id], onDelete: SetNull)
  name                     String
  business                 String
  email                    String
  phone                    String
  industry                 String?
  message                  String?
  preferredContact         String?
  urgency                  String?
  sourcePage               String?
  status                   LeadStatus           @default(NEW)
  tags                     String               @default("")
  notes                    String?
  pipelineStage            LeadPipelineStage    @default(NEW_LEAD)
  serviceRequested         String?
  serviceAddress           String?
  appointmentRequested     Boolean              @default(false)
  sourceCallLogId          String?
  sourceCallLog            CallLog?             @relation("LeadSourceCall", fields: [sourceCallLogId], references: [id], onDelete: SetNull)
  qualified                Boolean              @default(true)
  qualificationReason      String?
  classification           LeadClassification?
  classificationConfidence Float?
  source                   LeadSource           @default(WEB_FORM)
  dnc                      Boolean              @default(false)
  ip                       String?
  userAgent                String?
  callLogs                 CallLog[]
  messageThreads           MessageThread[]
  messages                 Message[]
  appointments             Appointment[]
  appointmentRequests      AppointmentRequest[]
  serviceRequests          ServiceRequest[]
  pipelineRecords          PipelineRecord[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
}

model ServiceRequest {
  id                     String       @id @default(cuid())
  orgId                  String
  organization           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  callLogId              String       @unique

model Task {
  id                  String         @id @default(cuid())
  orgId               String
  organization        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  status              TaskStatus     @default(OPEN)
  priority            TaskPriority   @default(MEDIUM)
  source              TaskSource     @default(MANUAL)
  entityType          String?
  entityId            String?
  assignedToUserId    String?
  assignedToUser      User?          @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdByUserId     String?
  createdByUser       User?          @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByAgentRunId String?
  dueAt               DateTime?
  completedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  reminders           TaskReminder[]
  followUpQueueItems  FollowUpQueueItem[]

  @@index([orgId, status, createdAt])
  @@index([orgId, assignedToUserId, status, dueAt])
  @@index([orgId, entityType, entityId, createdAt])
}

model TaskReminder {
  id                  String         @id @default(cuid())
  orgId               String
  organization        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  taskId              String
  task                Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  remindAt            DateTime
  sentAt              DateTime?
  status              String         @default("PENDING")
  createdAt           DateTime       @default(now())

  @@index([orgId, remindAt, status])
}

model FollowUpQueueItem {
  id                  String         @id @default(cuid())
  orgId               String
  organization        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  taskId              String?
  task                Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  entityType          String?
  entityId            String?
  reason              String
  status              String         @default("OPEN")
  suggestedAt         DateTime?
  resolvedAt          DateTime?
  createdByAgentRunId String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([orgId, status, createdAt])
}

model PipelineRecord {
  id                  String         @id @default(cuid())
  orgId               String
  organization        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leadId              String?
  lead                Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  stage               String
  confidence          Float?
  summary             String?
  isStale             Boolean        @default(false)
  staleReason         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  activities          PipelineActivityLog[]

  @@index([orgId, stage, createdAt])
  @@index([orgId, isStale, updatedAt])
}

model PipelineActivityLog {
  id                  String         @id @default(cuid())
  orgId               String
  organization        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pipelineRecordId    String
  pipelineRecord      PipelineRecord @relation(fields: [pipelineRecordId], references: [id], onDelete: Cascade)
  action              String
  detail              String?
  createdByUserId     String?
  createdByAgentRunId String?
  createdAt           DateTime       @default(now())

  @@index([orgId, pipelineRecordId, createdAt])
}
